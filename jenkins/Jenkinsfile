pipeline {
    agent any

    environment {
        // ---- Central config (change here, applies everywhere) ----
        AWS_REGION   = 'ap-south-1'
        GIT_REPO     = 'https://github.com/rajeshdangi409/cloudpulse-infra.git'
        NOTIFY_EMAIL = credentials('notify-email')

        // ---- GitOps / FluxCD config ----
        CLUSTER_NAME = 'cloudpulse-cluster'
        GITHUB_OWNER = 'rajeshdangi409'
        GITHUB_REPO  = 'cloudpulse-app'
        FLUX_PATH    = 'k8s'
    }

    triggers {
        githubPush()
    }

    options {
    ansiColor('xterm')
    }

    parameters {
        choice(name: 'ACTION', choices: ['apply', 'plan'], description: 'Terraform action to run (use the separate destroy pipeline to tear down)')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: "${GIT_REPO}"
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Lint & Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform fmt -check'
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Approval') {
            when { expression { params.ACTION != 'plan' } }
            steps {
                input message: "Proceed with terraform ${params.ACTION}?", ok: 'Yes, Proceed'
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir('terraform') {
                    sh 'terraform apply tfplan'
                }
            }
        }

        stage('Install FluxCD') {
            // GitOps bootstrap: install Flux into the freshly created cluster
            // and point it at the app repo's k8s/ folder. Idempotent — safe to
            // re-run; an already-bootstrapped cluster just reconciles.
            when { expression { params.ACTION == 'apply' } }
            environment {
                GITHUB_TOKEN = credentials('github-token')
            }
            steps {
                sh '''
                    # Point kubectl/flux at the new cluster
                    aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                    # Install Flux controllers into the cluster and wire them to Git.
                    # flux bootstrap also commits the GitRepository + Kustomization
                    # manifests into the app repo under ${FLUX_PATH}/flux-system/.
                    flux bootstrap github \
                      --owner=${GITHUB_OWNER} \
                      --repository=${GITHUB_REPO} \
                      --path=${FLUX_PATH} \
                      --branch=main \
                      --personal \
                      --token-auth
                '''
            }
        }
    }

    post {
        success {
            mail to: "${NOTIFY_EMAIL}",
                 subject: "✅ Infra ${params.ACTION} #${BUILD_NUMBER} Success",
                 body: "Terraform ${params.ACTION} completed successfully!\n\nBuild: ${BUILD_URL}"
        }
        failure {
            mail to: "${NOTIFY_EMAIL}",
                 subject: "❌ Infra ${params.ACTION} #${BUILD_NUMBER} Failed",
                 body: "Terraform ${params.ACTION} failed!\n\nCheck logs: ${BUILD_URL}"
        }
    }
}
